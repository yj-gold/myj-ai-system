# IG Markets API Credentials
# Copy this file to .env and fill in your real values

# Your IG API key (found in My IG > Settings > API keys)
IG_API_KEY=your_api_key_here

# Your IG login username
IG_USERNAME=your_username_here

# Your IG account password
IG_PASSWORD=your_password_here

# Account type: LIVE or DEMO
IG_ACCOUNT_TYPE=LIVE

# Optional: specific account ID to analyse (leave blank to use default)
# Find your account ID in My IG > Manage accounts
IG_ACCOUNT_ID=

# Date range for analysis (ISO format YYYY-MM-DD)
# Defaults: FROM = 2 years ago, TO = today
ANALYSIS_FROM_DATE=
ANALYSIS_TO_DATE=

# Output directory for exported files (defaults to ./output)
OUTPUT_DIR=./output

# ── Email Report Settings ──────────────────────────────────────────────────
# The address the report is sent FROM  (must match your SMTP account)
EMAIL_FROM=reports@myjcapital.com

# Comma-separated list of recipients
EMAIL_TO=you@example.com

# SMTP server settings
# Gmail example  : smtp.gmail.com  port 587  (use an App Password, not your real password)
# Outlook/365    : smtp.office365.com  port 587
# Custom server  : your mail server address
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=your_gmail_address@gmail.com
EMAIL_SMTP_PASSWORD=your_app_password_here

# Use STARTTLS (true) or direct SSL (false). Keep true for port 587.
EMAIL_USE_TLS=true

# ── Relevés mensuels clients ───────────────────────────────────────────────
# Registre des clients (aucun secret dedans) — défaut : clients.json
CLIENTS_FILE=clients.json

# Racine de l'archive des relevés — défaut : ./archive
# Pointez-la vers un disque sauvegardé / synchronisé pour la conservation.
ARCHIVE_DIR=./archive

# Identifiants IG par client : le registre référence ces NOMS de variables
# (champs api_key_env / username_env / password_env). Un bloc par client.
# IG_API_KEY_DUPONT=...
# IG_USERNAME_DUPONT=...
# IG_PASSWORD_DUPONT=...
