# IG Markets API Credentials
# Copy this file to .env and fill in your real values

# Your IG API key (found in My IG > Settings > API keys)
IG_API_KEY=your_api_key_here

# Your IG login username
IG_USERNAME=your_username_here

# Your IG account password
IG_PASSWORD=your_password_here

# Account type: LIVE or DEMO
IG_ACCOUNT_TYPE=LIVE

# Optional: specific account ID to analyse (leave blank to use default)
# Find your account ID in My IG > Manage accounts
IG_ACCOUNT_ID=

# Date range for analysis (ISO format YYYY-MM-DD)
# Defaults: FROM = 2 years ago, TO = today
ANALYSIS_FROM_DATE=
ANALYSIS_TO_DATE=

# Output directory for exported files (defaults to ./output)
OUTPUT_DIR=./output
